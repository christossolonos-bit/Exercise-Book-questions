# Copy to .env and fill in. .env is gitignored.

# Port the API listens on
PORT=5000

# Where the SQLite database file is stored. In production set this to a mounted
# persistent volume (e.g. /data on Railway) so accounts + answers survive redeploys.
DATA_DIR=

# Email address that gets admin access (sees all users + answers). The account
# that signs up/logs in with this email becomes the admin.
ADMIN_EMAIL=

# Secret used to sign login tokens (step 2). Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Where new-signup notifications go to Marios (step 6).
# A Discord channel webhook URL, or leave blank for now.
SIGNUP_WEBHOOK_URL=
