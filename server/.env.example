# Copy to .env and fill in. .env is gitignored.

# Port the API listens on
PORT=5000

# Where the SQLite database file is stored. In production set this to a mounted
# persistent volume (e.g. /data on Railway) so accounts + answers survive redeploys.
DATA_DIR=

# Email address that gets admin access (the members list). The account that
# signs up/logs in with this email becomes the admin.
ADMIN_EMAIL=

# Public base URL of the app (used to build password-reset links).
# Local: http://localhost:5173   Production: your Railway URL.
APP_URL=http://localhost:5173

# Sending password-reset emails via Gmail. SMTP_USER is your Gmail address,
# SMTP_PASS is a Gmail "App Password" (NOT your normal password — generate one
# at myaccount.google.com after enabling 2-Step Verification).
SMTP_USER=
SMTP_PASS=
# Optional friendly From line, e.g. "Who Are You? <you@gmail.com>"
MAIL_FROM=

# Secret used to sign login tokens (step 2). Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Where new-signup notifications go to Marios (step 6).
# A Discord channel webhook URL, or leave blank for now.
SIGNUP_WEBHOOK_URL=
