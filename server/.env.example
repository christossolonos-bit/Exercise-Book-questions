# Copy to .env and fill in. .env is gitignored.

# Port the API listens on
PORT=5000

# Secret used to sign login tokens (step 2). Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Where new-signup notifications go to Marios (step 6).
# A Discord channel webhook URL, or leave blank for now.
SIGNUP_WEBHOOK_URL=
